{
  "name": "@openquest/cli",
  "version": "0.1.0-draft.0",
  "description": "Command-line validator for OpenQuestSpec quest documents.",
  "license": "Apache-2.0",
  "author": "Arctic Flame Games Ltd",
  "type": "module",
  "keywords": [
    "openquest",
    "quest",
    "cli",
    "validator",
    "gamedev"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmith-game-dev/OpenQuestSpec.git",
    "directory": "packages/cli"
  },
  "bin": {
    "openquest": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@openquest/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
