{
  "name": "openquestspec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A specification for describing game quests, and a generator that turns it into engine-specific code.",
  "license": "Apache-2.0",
  "author": "Arctic Flame Games Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmith-game-dev/OpenQuestSpec.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "corpus": "node scripts/run-corpus.mjs",
    "corpus:meta": "node scripts/check-schema-meta.mjs",
    "purity": "node scripts/check-core-purity.mjs",
    "legal": "node scripts/check-legal-files.mjs",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "check": "pnpm run corpus:meta && pnpm run corpus && pnpm run purity && pnpm run legal && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ajv": "^8.17.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
